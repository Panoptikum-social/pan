# Copy this file to .env (gitignored) and fill in real values before
# building/running the QA docker-compose stack on the target server:
#
#   cp .env.example .env
#   $EDITOR .env
#   docker compose up -d
#
# docker-compose.yml reads this automatically (no extra flag needed) and
# uses it both to substitute ${VARS} inside docker-compose.yml itself (e.g.
# the db service's POSTGRES_PASSWORD) and to populate the app container's
# environment — see config/runtime.exs's `config_env() == :qa` branch for
# what the app does with each one. Keeping it in one file means the DB
# password only needs setting once, instead of kept in sync across two
# files by hand.

# Must be the same value the db service uses to initialize Postgres and the
# app uses to connect to it.
POSTGRES_PASSWORD=changeme

# openssl rand -base64 48
SECRET_KEY_BASE=run `openssl rand -base64 48` and paste the result here

# This server's actual domain/IP (used for PanWeb.Endpoint's url + check_origin).
PAN_HOST=qa.panoptikum.social

# Only needed if you change the published port away from 4001 (see
# docker-compose.yml's `ports:`).
# PAN_PORT=4001
