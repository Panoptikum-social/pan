import Config

# Copy this file to config/qa.secret.exs (gitignored) and fill in real
# values before building the QA image on the target server:
#
#   cp config/qa.secret.exs.example config/qa.secret.exs
#   $EDITOR config/qa.secret.exs
#   docker compose build
#   docker compose up -d

config :pan, Pan.Repo,
  username: "postgres",
  password: "changeme",
  database: "pan_qa",
  # "db" is the Postgres service name in docker-compose.yml
  hostname: "db",
  pool_size: 10

config :pan, PanWeb.Endpoint,
  secret_key_base: "run `openssl rand -base64 48` and paste the result here",
  # change host/port to this server's actual domain/IP and published port
  url: [scheme: "http", host: "qa.panoptikum.social", port: 4001],
  check_origin: ["http://qa.panoptikum.social:4001"]

# Defaults to not sending real mail from QA. Switch to Swoosh.Adapters.SMTP
# (see config/prod.secret.exs for the shape) if you need to test outgoing
# mail flows from this environment.
config :pan, Pan.Mailer, adapter: Swoosh.Adapters.Local
