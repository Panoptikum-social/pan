<div class="m-2">
  <%= if @podcast.blocked == true do %>
    This podcast may not be published here, sorry.
  <% else %>
    <div class="rounded-xl shadow bg-base-100">
      <div class="px-4 py-3 font-semibold border-b-2 border-podcast">
        {icon("rss")} Feeds for
        <.link
          href={podcast_frontend_path(@conn, :show, @podcast)}
          class="underline hover:text-primary"
        >{@podcast.title}</.link>
      </div>
      <div class="p-4">
        <ul class="list-disc ml-4">
          <%= for feed <- @podcast.feeds do %>
            <li>
              <.link href={feed.self_link_url} class="underline hover:text-primary">{feed.self_link_title ||
                feed.self_link_url}</.link>
              <%= if feed.alternate_feeds != [] do %>
                <h2 class="text-2xl my-4">
                  Alternate feeds
                </h2>
                <ul class="list-disc">
                  <%= for alternate_feed <- feed.alternate_feeds do %>
                    <li>
                      <.link
                        href={String.downcase(alternate_feed.url)}
                        class="underline hover:text-primary"
                      >{alternate_feed.title}</.link>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
