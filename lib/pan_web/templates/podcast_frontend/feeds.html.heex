<div class="m-2">
  <%= if @podcast.blocked == true do %>
    {dgettext("frontend", "This podcast may not be published here, sorry.")}
  <% else %>
    <div class="rounded-xl shadow bg-base-100">
      <div class="px-4 py-3 font-semibold border-b-2 border-podcast">
        {icon("rss")} {dgettext("frontend", "Feeds for")}
        <.link
          href={podcast_frontend_path(@conn, :show, @podcast)}
          class="underline hover:text-primary"
        >{@podcast.title}</.link>
      </div>
      <div class="p-4">
        <ul class="list-disc ml-4">
          <%= for feed <- @podcast.feeds do %>
            <li>
              <.external_link href={feed.self_link_url}>
                {feed.self_link_title || feed.self_link_url}
              </.external_link>
              <%= if feed.alternate_feeds != [] do %>
                <h2 class="text-2xl my-4">
                  {dgettext("frontend", "Alternate feeds")}
                </h2>
                <ul class="list-disc">
                  <%= for alternate_feed <- feed.alternate_feeds do %>
                    <li>
                      <.external_link href={alternate_feed.url}>
                        {alternate_feed.title}
                      </.external_link>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>
</div>
