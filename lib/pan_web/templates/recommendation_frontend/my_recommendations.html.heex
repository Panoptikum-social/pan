<div class="flex flex-col lg:flex-row space-y-4 lg:space-y-0 lg:space-x-4">
  <div class="flex flex-col space-y-4">
    <PanWeb.Component.Panel.render heading="Your Podcast Recommendations" purpose="recommendation">
      <ul class="m-4 flex flex-col divide-y divide-dashed divide-base-300">
        <%= for recommendation <- @podcast_recommendations do %>
          <li class="mt-2 pt-2">
            <div class="flex justify-between">
              <PanWeb.Component.PodcastButton.render for={recommendation.podcast} />
              <span class="text-sm text-base-content/70">{to_string(recommendation.inserted_at)}</span>
            </div>
            {recommendation.comment}
            <p class="text-right">
              <.link
                href={recommendation_frontend_path(@conn, :delete, recommendation)}
                method="delete"
                data-confirm="Are you sure?"
                class="btn btn-error btn-xs"
              >Delete</.link>
            </p>
          </li>
        <% end %>
      </ul>
    </PanWeb.Component.Panel.render>

    <PanWeb.Component.Panel.render heading="Your Episode Recommendations" purpose="recommendation">
      <ul class="m-4 flex flex-col divide-y divide-dashed divide-base-300">
        <%= for recommendation <- @episode_recommendations do %>
          <li class="mt-2 pt-2">
            <div class="flex justify-between">
              <div class="flex flex-col space-y-1">
                <PanWeb.Component.PodcastButton.render for={recommendation.episode.podcast} />
                <PanWeb.Component.EpisodeButton.render for={recommendation.episode} />
              </div>
              <span class="text-sm text-base-content/70">{to_string(recommendation.inserted_at)}</span>
            </div>
            {recommendation.comment}
            <p class="text-right">
              <.link
                href={recommendation_frontend_path(@conn, :delete, recommendation)}
                method="delete"
                data-confirm="Are you sure?"
                class="btn btn-error btn-xs"
              >Delete</.link>
            </p>
          </li>
        <% end %>
      </ul>
    </PanWeb.Component.Panel.render>

    <PanWeb.Component.Panel.render heading="Your Chapter Recommendations" purpose="recommendation">
      <ul class="m-4 flex flex-col divide-y divide-dashed divide-base-300">
        <%= for recommendation <- @chapter_recommendations do %>
          <li class="mt-2 pt-2">
            <div class="flex justify-between">
              <div class="flex flex-col space-y-1">
                <PanWeb.Component.PodcastButton.render for={
                  recommendation.chapter.episode.podcast
                } />
                <PanWeb.Component.EpisodeButton.render for={recommendation.chapter.episode} />
                <span class="text-sm">
                  {icon("indent-increase", class: "h-4 w-4 inline")} {recommendation.chapter.title}
                </span>
              </div>
              <span class="text-sm text-base-content/70">{to_string(recommendation.inserted_at)}</span>
            </div>
            {recommendation.comment}
            <p class="text-right">
              <.link
                href={recommendation_frontend_path(@conn, :delete, recommendation)}
                method="delete"
                data-confirm="Are you sure?"
                class="btn btn-error btn-xs"
              >Delete</.link>
            </p>
          </li>
        <% end %>
      </ul>
    </PanWeb.Component.Panel.render>
  </div>

  <div>
    <PanWeb.Component.Panel.render heading="Unrecommended Podcasts" purpose="podcast">
      <ul class="m-4 flex flex-col space-y-4">
        <%= for podcast <- @unrecommended_podcasts do %>
          <li>
            <.form :let={f} for={@changeset} action={recommendation_frontend_path(@conn, :create)}>
              <div class="flex flex-col lg:flex-row gap-4">
                <div class="grow">
                  <div class="flex justify-between">
                    Your recommendation for: &nbsp; {podcast.title}
                    <small class="text-base-content/70" id={"remaining#{podcast.id}"}>
                      255
                    </small>
                  </div>
                  <.input field={f[:podcast_id]} type="hidden" value={podcast.id} />
                  <.input
                    field={f[:comment]}
                    type="text"
                    maxlength="255"
                    data-remaining-counter={"remaining#{podcast.id}"}
                    class="input input-bordered w-full"
                  />
                </div>
                <div class="shrink-0 self-end">
                  <button type="submit" class="btn btn-info btn-sm">{icon("thumb-up")} Recommend</button>
                </div>
              </div>
            </.form>
          </li>
        <% end %>
      </ul>
    </PanWeb.Component.Panel.render>
  </div>
</div>
