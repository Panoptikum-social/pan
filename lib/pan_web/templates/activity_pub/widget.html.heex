<ul class="my-4 list-disc ml-8">
  <%= if @toots do %>
    <%= for toot <- @toots do %>
      <li class="media text-base-content">
        <div class="float-left">
          <img src={toot.attributed_to_image} height="70" alt={toot.name} class="thumbnail" />
        </div>

        <div class="media-body">
          <b>
            {toot.name}
          </b>
          <span class="text-base-content/70">
            <.link href={toot.actor_url} class="underline hover:text-primary">{toot.preferred_username}</.link>
            - {if toot.boosted, do: "boosted"}
            {toot.published}
          </span>
          <br />

          <%= if toot.boosted do %>
            <b>
              {toot.attributed_to_name}
            </b>
            <span>
              <.link href={toot.attributed_to_url} class="underline hover:text-primary">{toot.attributed_to_preferred_username}</.link>
              -
            </span>
          <% end %>

          {toot.content}
        </div>
      </li>
    <% end %>
  <% else %>
    No toots so far.
  <% end %>
</ul>
