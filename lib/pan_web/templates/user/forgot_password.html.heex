<div class="m-4 flex justify-center">
  <div>
    <h1 class="text-3xl">
      {dgettext("frontend", "Forgot your password?")}
    </h1>

    <.form
      :let={f}
      for={%{}}
      as={:user}
      action={user_path(@conn, :request_login_link)}
      class="p-4 mb-4 flex flex-col items-start space-y-4"
    >
      <.input field={f[:email]} type="email" label={dgettext("frontend", "Email")} class="input" />

      <p>
        {dgettext(
          "frontend",
          "Submitting this form will transfer a session cookie to the server."
        )} <br />{dgettext("frontend", "See")}
        <a class="underline hover:text-primary" href={PanWeb.Blog.url("/privacy/")}>
          {dgettext("frontend", "Privacy")}
        </a>
        {dgettext("frontend", "for details.")}
      </p>

      <button type="submit" class="btn btn-primary">{dgettext("frontend", "Request Login Link")}</button>
    </.form>
  </div>
</div>
