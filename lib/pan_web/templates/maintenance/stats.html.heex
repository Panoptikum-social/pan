<div class="m-4 max-w-6xl">
  <h1 class="text-3xl mb-4">
    Statistics
  </h1>

  <.needs_attention stats={[
    %{
      title: "Stale podcasts",
      metric: :stale_podcasts,
      value: @stale_podcasts,
      desc: "next update overdue",
      href: podcast_path(@conn, :stale)
    },
    %{
      title: "Retired podcasts",
      metric: :retired_podcasts,
      value: @retired_podcasts,
      desc: "to be tackled",
      href: podcast_path(@conn, :deprecated)
    },
    %{
      title: "Duplicate podcasts",
      metric: :duplicate_podcasts,
      value: @duplicate_podcasts |> Map.values() |> Enum.sum(),
      desc:
        "#{@duplicate_podcasts.different_show} different show, #{@duplicate_podcasts.same_feed_url} same feed URL, #{@duplicate_podcasts.same_title} same title, #{@duplicate_podcasts.alternate} alternate feed",
      href: podcast_path(@conn, :duplicates)
    },
    %{
      title: "Deletable users",
      metric: :deletable_users,
      value: @deletable_users,
      desc: "marked > #{PanWeb.User.deletion_grace_days()} days",
      href: user_path(@conn, :retention)
    }
  ]} />

  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <.stat_card
      title="Podcasts"
      icon="podcast-lineawesome-solid"
      accent="border-t-primary"
      value={@total_podcasts}
    >
      <.metric label="inactive" value={@inactive_podcasts} />
      <.metric label="retirement candidates (≥ 9 failures)" value={@retirement_candidates} />
      <.metric label="thumbnails missing" value={@podcasts_without_image} />
    </.stat_card>

    <.stat_card
      title="Updates"
      icon="cog-heroicons-outline"
      accent="border-t-info"
      value={@podcasts_per_hour}
      unit="p/h"
    >
      <.metric label="average update intervall" value={"#{@average_update_intervall} h"} />
      <.metric label="feed backlog" value={@total_feed_backlogs} />
    </.stat_card>

    <.stat_card
      title="Episodes"
      icon="headphones-lineawesome-solid"
      accent="border-t-secondary"
      value={@total_episodes}
    >
      <.metric label="unindexed (not in full text search)" value={@unindexed_episodes} />
    </.stat_card>

    <.stat_card
      title="Users"
      icon="user-heroicons-outline"
      accent="border-t-accent"
      value={@total_users}
    >
      <.metric label="subscriptions" value={@total_subscriptions} />
      <.metric label="likes" value={@total_likes} />
      <.metric label="recommendations" value={@total_recommendations} />
      <.metric label="follows" value={@total_follows} />
      <.metric label="opmls" value={@total_opmls} />
    </.stat_card>

    <.stat_card
      title="Personas"
      icon="user-astronaut-lineawesome-solid"
      accent="border-t-success"
      value={@total_personas}
    >
      <.metric label="engagements" value={@total_engagements} />
      <.metric label="gigs" value={@total_gigs} />
      <.metric label="manifestations" value={@total_manifestations} />
      <.metric label="delegations" value={@total_delegations} />
      <.metric label="thumbnails missing" value={@personas_without_image} />
    </.stat_card>

    <.stat_card title="Feeds" icon="rss-heroicons-outline" accent="border-t-warning">
      <.metric label="without headers" value={@feeds_without_headers} />
      <.metric label="with etag" value={@feeds_with_etag} />
      <.metric label="with last modified" value={@feeds_with_last_modified} />
    </.stat_card>

    <.stat_card
      title="Categories & languages"
      icon="folder-open-heroicons-outline"
      accent="border-t-neutral"
    >
      <.metric label="categories" value={@total_categories} />
      <.metric label="categorizations" value={@total_categorizations} />
      <.metric label="languages" value={@total_languages} />
    </.stat_card>
  </div>
</div>
