<.link href={category_frontend_path(@conn, :index)}>
  {icon("folder-open")} Panoptikum
</.link>
/
<%= if @category.parent do %>
  <.link href={category_frontend_path(@conn, :show, @category.parent.id)}>
    {icon("folder-open")} {@category.parent.title}
  </.link>
  /
<% end %>
<.link href={category_frontend_path(@conn, :show, @category)}>
  {icon("folder-open")} {@category.title}
</.link>

<h1 class="text-3xl my-4">
  {icon("folder-open")}
  {@category.title}
</h1>

<div x-data="{ selectedTab: 0}" class="pt-4">
  <ul class="flex flex-wrap border-b border-base-300">
    <%= for {category, index} <- Enum.with_index(@categories) do %>
      <li class="-mb-px ml-1.5">
        <a
          class="inline-block rounded-t px-2 py-1.5 hover:text-primary border-base-300"
          x-bind:class={"{ 'disabled font-semibold bg-base-100 border-l border-t border-r text-base-content' :
                       selectedTab === #{index},
                     'bg-base-300 text-base-content/70' :
                     selectedTab !== #{index} }"}
          @click.prevent={"selectedTab = #{index}"}
          to="#"
        >
          {category.title}
        </a>
      </li>
    <% end %>
  </ul>

  <div class="pt-4">
    <%= for {category, index} <- Enum.with_index(@categories) do %>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-4" x-show={"selectedTab === #{index}"}>
        <%= for podcast <- category.podcasts do %>
          {render("_podcast_widget.html", conn: @conn, podcast: podcast)}
        <% end %>
      </div>
    <% end %>
  </div>
</div>
