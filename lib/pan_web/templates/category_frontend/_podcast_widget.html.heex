<div class="rounded-xl shadow bg-base-100">
  <div class="px-4 py-3 font-semibold border-b-2 border-podcast">
    <.link
      href={podcast_frontend_path(@conn, :show, @podcast.id)}
      class="truncate hover:underline"
    >
      {icon("microphone", class: "w-4 h-4 inline align-text-top")} {@podcast.title}
    </.link>
  </div>

  <div>
    <div class="flex flex-col md:flex-row p-4">
      <div class="flex-none p-2 xl:mr-4 my-2 border border-base-300 shadow m-auto">
        <%= if podcast_thumbnail = @podcast.thumbnails != [] && List.first(@podcast.thumbnails) do %>
          <img
            src={"https://panoptikum.social#{podcast_thumbnail.path}#{podcast_thumbnail.filename}"}
            width="150"
            height="150"
            alt={@podcast.image_title || podcast_thumbnail.filename}
            id="photo"
            class="wrap-break-word text-xs"
          />
        <% else %>
          <img src="/images/missing-podcast.png" alt="missing image" width="150" height="150" />
        <% end %>
      </div>
      <div class="grid grid-cols-3 gap-x-4 gap-y-2">
        <%= if @podcast.website do %>
          <div class="text-right">
            <label class="label">
              Website
            </label>
          </div>
          <div class="col-span-2">
            <%= if safe_uri?(@podcast.website) do %>
              <.link
                href={safe_href(@podcast.website)}
                class="underline truncate hover:text-primary"
              >{@podcast.website}</.link>
            <% else %>
              <span class="truncate">{@podcast.website}</span>
            <% end %>
          </div>
        <% end %>

        <div class="text-right">
          <label class="label">
            Available since
          </label>
        </div>
        <div class="col-span-2">
          {icon("calendar")}
          {Calendar.strftime(@podcast.inserted_at, "%x")}
        </div>

        <div class="text-right">
          <label class="label">
            Categories
          </label>
        </div>
        <div class="col-span-2 flex flex-col space-y-1">
          <%= for category <- @podcast.categories do %>
            <PanWeb.Component.CategoryLink.render for={category} truncate />
          <% end %>
        </div>

        <div class="text-right">
          <label class="label">
            Contributors
          </label>
        </div>
        <div class="col-span-2 grid grid-cols-3 gap-1 place-items-start">
          <%= for engagement <- @podcast.engagements do %>
            <PanWeb.Component.PersonaButton.render
              for={engagement.persona}
              class="col-span-2 truncate max-w-full"
            />
            <span class="badge badge-outline badge-success badge-sm">
              {engagement.role}
            </span>
          <% end %>
        </div>

        <%= if @podcast.payment_link_url do %>
          <div class="text-right">
            Support
          </div>
          <%= if safe_uri?(@podcast.payment_link_url) do %>
            <.link
              href={safe_href(@podcast.payment_link_url)}
              class="col-span-2 underline hover:text-primary"
            >{@podcast.payment_link_title}</.link>
          <% else %>
            <span class="col-span-2">{@podcast.payment_link_title}</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="m-4">
      <h4 class="text-lg">
        Description
      </h4>
      {@podcast.description}

      <%= if @podcast.description != @podcast.summary do %>
        <h4 class="text-lg">
          Summary
        </h4>
        {@podcast.summary}
      <% end %>
    </div>
  </div>
</div>
