<div class="m-4">
  <h1 class="text-3xl">
    {dgettext("frontend", "My OPML files")}
  </h1>

  <%= if @opmls != [] do %>
    <table class="table table-zebra table-xs my-4 w-auto">
      <thead>
        <tr>
          <th>{dgettext("frontend", "Content type")}</th>
          <th>{dgettext("frontend", "Filename")}</th>
          <th>{dgettext("frontend", "Upload date")}</th>
          <th>{dgettext("frontend", "Actions")}</th>
        </tr>
      </thead>
      <tbody>
        <%= for opml <- @opmls do %>
          <tr>
            <td>{opml.content_type}</td>
            <td>{opml.filename}</td>
            <td>{Calendar.strftime(opml.inserted_at, "%c")}</td>

            <td class="leading-8">
              <.link
                href={opml_frontend_path(@conn, :import, opml)}
                method="post"
                class="btn btn-outline btn-info btn-sm whitespace-nowrap"
              >
                {icon("settings", class: "inline w-4 h-4 align-text-top")} {dgettext(
                  "frontend",
                  "Parse"
                )}
              </.link>
              &nbsp;
              <.link
                href={opml_frontend_path(@conn, :download, opml)}
                class="btn btn-outline btn-primary btn-sm whitespace-nowrap"
              >
                {icon("file-download",
                  class: "inline w-4 h-4 align-text-top"
                )} {dgettext("frontend", "Download")}
              </.link>
              &nbsp;
              <.link
                href={opml_frontend_path(@conn, :delete, opml)}
                method="delete"
                data-confirm={dgettext("frontend", "Are you sure?")}
                class="btn btn-outline btn-error btn-sm whitespace-nowrap"
              >
                {icon("trash", class: "inline w-4 h-4 align-text-top")} {dgettext(
                  "frontend",
                  "Delete"
                )}
              </.link>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="m-4">
      {dgettext("frontend", "No OPML files uploaded so far")}
    </p>
  <% end %>

  <.link href={opml_frontend_path(@conn, :new)} class="underline hover:text-primary">{dgettext(
    "frontend",
    "New OPML"
  )}</.link>
</div>
