<div class="m-4">
  <h1 class="text-3xl">Listing invoices</h1>

  <table class="table table-zebra table-xs my-4 w-auto">
    <thead>
      <tr>
        <th>Filename</th>
        <th>Content type</th>
        <th>Path</th>
        <th>User Id</th>
        <th>Username</th>
        <th>User Name</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= for invoice <- @invoices do %>
        <tr>
          <td>{invoice.filename}</td>
          <td>{invoice.content_type}</td>
          <td>{invoice.path}</td>
          <td>
            <.link href={databrowser_path(@conn, :show, "user", invoice.user)}>{invoice.user_id}</.link>
          </td>
          <td>{invoice.user.username}</td>
          <td>{invoice.user.name}</td>
          <td>
            <.link
              href={invoice_path(@conn, :show, invoice)}
              class="btn btn-outline btn-info btn-xs truncate max-w-full"
            >Show</.link>
            <.link
              href={invoice_path(@conn, :edit, invoice)}
              class="btn btn-outline btn-warning btn-xs truncate max-w-full"
            >Edit</.link>
            <.link
              href={invoice_path(@conn, :delete, invoice)}
              method="delete"
              data-confirm="Are you sure?"
              class="btn btn-outline btn-error btn-xs truncate max-w-full"
            >Delete</.link>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <.link href={invoice_path(@conn, :new)} class="underline hover:text-primary">New invoice</.link>
</div>
