<div class="m-4">
  <h1 class="text-3xl">
    Show invoice
  </h1>

  <ul class="m-4">
    <li>
      <strong>Filename:</strong>
      {@invoice.filename}
    </li>

    <li>
      <strong>Content type:</strong>
      {@invoice.content_type}
    </li>

    <li>
      <strong>Path:</strong>
      {@invoice.path}
    </li>

    <li>
      <strong>User:</strong>
      {@invoice.user_id}
    </li>
  </ul>

  <.link href={invoice_path(@conn, :edit, @invoice)} class="underline hover:text-primary">Edit</.link>
  <.link href={invoice_path(@conn, :index)} class="underline hover:text-primary">Back</.link>
</div>
