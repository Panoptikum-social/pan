<form action={search_frontend_path(@conn, :new)} method="post" class="py-4 flex">
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <input
    type="text"
    name="search[term]"
    size="15"
    placeholder="Search"
    class="flex-1 bg-base-100 text-base-content"
  /> &nbsp;
  <button
    type="submit"
    class="p-2 text-sm rounded border border-base-300 bg-base-100 hover:bg-base-200 align-middle"
    title="Submit"
  >
    {nav_icon("search")}
  </button>
</form>

<ul>
  <li class="py-1">
    <.link
      href={category_frontend_path(@conn, :index)}
      title="Categories"
      class="visible-xs-inline"
    >
      {nav_icon("map")} Categories
    </.link>
  </li>
  <li class="py-1">
    <.link href={community_frontend_path(@conn, :index)} title="Communities">
      {nav_icon("users")} Communities
    </.link>
  </li>
  <li class="py-1">
    <.link href={recommendation_frontend_path(@conn, :random)}>
      {nav_icon("flask")} Random Recommendation
    </.link>
  </li>
  <li class="py-1">
    <.link href={recommendation_frontend_path(@conn, :index)}>
      {nav_icon("gift")} Latest Recommendations
    </.link>
  </li>
  <li class="py-1">
    <a href="https://blog.panoptikum.social/">
      {nav_icon("help-circle-filled")} About
    </a>
  </li>
  <li class="py-1">
    <a href="https://blog.panoptikum.social/blog">
      {nav_icon("news")} Blog
    </a>
  </li>
  <li class="py-1">
    <.link href={persona_frontend_path(@conn, :index)}>
      {nav_icon("user-star")} Podcasters
    </.link>
  </li>
  <li class="py-1">
    <.link href={user_frontend_path(@conn, :index)}>
      {nav_icon("user")} Users
    </.link>
  </li>

  <%= if @current_user do %>
    <%= if @current_user.admin do %>
      <li class="py-1">
        {nav_icon("adjustments-horizontal")}
        <.link href={dashboard_path(@conn, :home)}>Administration</.link>
      </li>
    <% end %>

    <li class="py-1">
      {render("_user_dropdown.html", conn: @conn, current_user: @current_user)}
    </li>
    <li class="border-t-2"></li>
    <li class="py-1">
      <.link href={session_path(@conn, :delete, @current_user)} method="delete">
        {nav_icon("logout")} Log Out
      </.link>
    </li>
  <% else %>
    <li class="py-1">
      <.link href={user_frontend_path(@conn, :new)}>
        {nav_icon("pencil")} Sign Up
      </.link>
    </li>
    <li class="py-1">
      <.link href={session_path(@conn, :new)}>
        {nav_icon("login")} Log In
      </.link>
    </li>
  <% end %>
</ul>
