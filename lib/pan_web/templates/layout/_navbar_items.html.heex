<form action={search_frontend_path(@conn, :new)} method="post" class="py-4 flex">
  <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
  <input
    type="text"
    name="search[term]"
    size="15"
    placeholder={dgettext("frontend", "Search")}
    class="flex-1 bg-sidebar-field text-base-content"
  /> &nbsp;
  <button
    type="submit"
    class="p-2 text-sm rounded border border-base-300 bg-sidebar-field hover:bg-base-300 align-middle"
    title={dgettext("frontend", "Submit")}
  >
    {nav_icon("search")}
  </button>
</form>

<ul>
  <li class="py-1">
    <.link
      href={category_frontend_path(@conn, :index)}
      title={dgettext("frontend", "Categories")}
      class="visible-xs-inline"
    >
      {nav_icon("map")} {dgettext("frontend", "Categories")}
    </.link>
  </li>
  <li class="py-1">
    <.link
      href={community_frontend_path(@conn, :index)}
      title={dgettext("frontend", "Communities")}
    >
      {nav_icon("users")} {dgettext("frontend", "Communities")}
    </.link>
  </li>
  <li class="py-1">
    <.link href={podcast_frontend_path(@conn, :index)}>
      {nav_icon("microphone")} {dgettext("frontend", "New Podcasts")}
    </.link>
  </li>
  <li class="py-1">
    <.link href={episode_frontend_path(@conn, :index)}>
      {nav_icon("headphones")} {dgettext("frontend", "New Episodes")}
    </.link>
  </li>
  <li class="py-1">
    <.link href={recommendation_frontend_path(@conn, :random)}>
      {nav_icon("flask")} {dgettext("frontend", "Random Recommendation")}
    </.link>
  </li>
  <li class="py-1">
    <.link href={recommendation_frontend_path(@conn, :index)}>
      {nav_icon("gift")} {dgettext("frontend", "Latest Recommendations")}
    </.link>
  </li>
  <li class="py-1">
    <a href="https://blog.panoptikum.social/">
      {nav_icon("help")} {dgettext("frontend", "About")}
    </a>
  </li>
  <li class="py-1">
    <a href="https://blog.panoptikum.social/blog/">
      {nav_icon("news")} {dgettext("frontend", "Blog")}
    </a>
  </li>
  <li class="py-1">
    <a href="https://blog.panoptikum.social/manuals/">
      {nav_icon("book")} {dgettext("frontend", "Manuals")}
    </a>
  </li>
  <li class="py-1">
    <.link href={persona_frontend_path(@conn, :index)}>
      {nav_icon("user-star")} {dgettext("frontend", "Podcasters")}
    </.link>
  </li>
  <li class="py-1">
    <.link href={user_frontend_path(@conn, :index)}>
      {nav_icon("user")} {dgettext("frontend", "Users")}
    </.link>
  </li>

  <%= if @current_user do %>
    <%= if @current_user.admin do %>
      <li class="py-1">
        {nav_icon("adjustments-horizontal")}
        <.link href={dashboard_path(@conn, :home)}>{dgettext("frontend", "Administration")}</.link>
      </li>
    <% end %>

    <li class="py-1">
      {render("_user_dropdown.html", conn: @conn, current_user: @current_user)}
    </li>
    <li class="border-t-2 sidebar-divider"></li>
    <li class="py-1">
      <.link href={session_path(@conn, :delete, @current_user)} method="delete">
        {nav_icon("logout")} {dgettext("frontend", "Log Out")}
      </.link>
    </li>
  <% else %>
    <li class="py-1">
      <.link href={user_frontend_path(@conn, :new)}>
        {nav_icon("pencil")} {dgettext("frontend", "Sign Up")}
      </.link>
    </li>
    <li class="py-1">
      <.link href={session_path(@conn, :new)}>
        {nav_icon("login")} {dgettext("frontend", "Log In")}
      </.link>
    </li>
  <% end %>
</ul>
