<main
  role="main"
  data-theme="latte"
  data-theme-toggle-scope
  phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["data-theme"])}
  class="bg-base-200 px-4 mx-auto mb-4 min-h-screen text-base-content"
>
  <PanWeb.Component.ThemeToggle.render />
  <.flash kind={:info} flash={@flash} />
  <.flash kind={:error} flash={@flash} />

  {@inner_content}
</main>
