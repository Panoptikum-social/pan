<!DOCTYPE html>
<html lang={assigns[:locale] || "en"} class="h-full">
  {render("_head.html", conn: @conn)}

  <body
    class="flex flex-col lg:flex-row lg:h-full text-base-content bg-base-300 scrollbar-gray"
    data-js-view-name={js_view_name(@conn, view_template(@conn))}
  >
    <nav
      x-data="navbar"
      class="h-full flex flex-col p-4 justify-start lg:overflow-y-auto bg-sidebar sidebar-line"
      x-bind:class="{'lg:p-1': !navbarOpen}"
    >
      {in_nav_locale(@conn, "_navbar.html", conn: @conn, current_user: @current_user)}
    </nav>

    <div class="flex-1 min-h-full flex flex-col overflow-x-auto">
      <div class="bg-base-200 flex-1 text-base-content">
        {@inner_content}
      </div>

      <footer class="p-4 flex flex-wrap bg-sidebar footer-line">
        {in_nav_locale(@conn, "_footer.html", conn: @conn, current_user: @current_user)}
      </footer>
    </div>
  </body>
</html>
