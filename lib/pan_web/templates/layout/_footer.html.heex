<ul
  :for={
    {section, links} <- [
      {"Meta",
       [
         {"https://blog.panoptikum.social/code_of_conduct/", "heart-handshake",
          "Code of Conduct"},
         {"https://blog.panoptikum.social/privacy/", "lock", "Privacy"},
         {"https://blog.panoptikum.social/complaints/", "flag", "Complaints"},
         {"https://blog.panoptikum.social/community/", "users-group", "Community"},
         {"https://blog.panoptikum.social/api/", "api", "API"},
         {"https://blog.panoptikum.social/imprint/", "id", "Imprint"}
       ]},
      {"About",
       [
         {"https://blog.panoptikum.social/talks/", "presentation", "Talks"},
         {"https://blog.panoptikum.social/community/", "help", "FAQ"}
       ]},
      {"Support",
       [
         {"https://www.waldgruber.at", "user-heart", "Community Manager Sonja"},
         {"https://carmenh.dev/", "robot", "Bot Expert Carmen"}
       ]},
      {"Development & Hosting",
       [{"https://www.informatom.com", "code", "Informatom EDV-Dienstleistungen e.U."}]}
    ]
  }
  class="flex flex-wrap items-center gap-x-4 mr-12"
>
  <li class="uppercase text-base-content/70">{section}</li>
  <li :for={{href, icon, label} <- links}>
    <a href={href} class="inline-flex items-center gap-1 hover:underline">
      {icon(icon, class: "size-4 shrink-0")} {label}
    </a>
  </li>
</ul>
