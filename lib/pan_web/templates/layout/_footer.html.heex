<ul
  :for={
    {section, links} <- [
      {dgettext("frontend", "Meta"),
       [
         {PanWeb.Blog.url("/code-of-conduct/"), "heart-handshake",
          dgettext("frontend", "Code of Conduct")},
         {PanWeb.Blog.url("/privacy/"), "lock", dgettext("frontend", "Privacy")},
         {PanWeb.Blog.url("/complaints/"), "flag", dgettext("frontend", "Complaints")},
         {PanWeb.Blog.url("/community/"), "users-group", dgettext("frontend", "Community")},
         {PanWeb.Blog.url("/api/"), "api", "API"},
         {PanWeb.Blog.url("/imprint/"), "id", dgettext("frontend", "Imprint")}
       ]},
      {dgettext("frontend", "About"),
       [
         {PanWeb.Blog.url("/talks/"), "presentation", dgettext("frontend", "Talks")},
         {PanWeb.Blog.url("/community/"), "help", dgettext("frontend", "FAQ")}
       ]},
      {dgettext("frontend", "Support"),
       [
         {"https://www.waldgruber.at", "user-heart",
          dgettext("frontend", "Community Manager Sonja")},
         {"https://carmenh.dev/", "robot", dgettext("frontend", "Bot Expert Carmen")}
       ]},
      {dgettext("frontend", "Development & Hosting"),
       [{"https://www.informatom.com", "code", "Informatom EDV-Dienstleistungen e.U."}]}
    ]
  }
  class="flex flex-wrap items-center gap-x-4 mr-12"
>
  <li class="uppercase text-base-content/70">{section}</li>
  <li :for={{href, icon, label} <- links}>
    <a href={href} class="inline-flex items-center gap-1 hover:underline">
      {icon(icon, class: "size-4 shrink-0")} {label}
    </a>
  </li>
</ul>
