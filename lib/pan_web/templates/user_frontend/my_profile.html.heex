<div class="my-4">
  <div class="float-right">
    <.link
      href={user_frontend_path(@conn, :edit)}
      class="btn btn-warning"
    >{dgettext("frontend", "Edit your data")}</.link>
  </div>
  <h1 class="text-3xl">
    {dgettext("frontend", "My Profile")}
  </h1>
</div>

<div class="grid grid-cols-2 gap-4">
  <div class="justify-self-end">{dgettext("frontend", "User Name")}</div>
  <div>{@user.username}</div>

  <div class="justify-self-end">{dgettext("frontend", "Full Name")}</div>
  <div>{@user.name}</div>

  <div class="justify-self-end">{dgettext("frontend", "Email")}</div>
  <div>{@user.email}</div>

  <%= if @user.admin do %>
    <div class="justify-self-end">{dgettext("frontend", "Admin")}</div>
    <div>{dgettext("frontend", "I have admin privileges.")}</div>
  <% end %>

  <div class="justify-self-end">{dgettext("frontend", "Podcaster")}</div>
  <div>
    <%= if @user.podcaster do %>
      {dgettext("frontend", "I am a podcaster myself.")}
    <% else %>
      {dgettext("frontend", "I am not a podcaster.")}
    <% end %>
  </div>

  <div class="justify-self-end">{dgettext("frontend", "Privacy")}</div>
  <div>
    <%= if @user.share_follows do %>
      {dgettext("frontend", "I do currently share my followings.")}
    <% else %>
      {dgettext("frontend", "I do not share my followings.")}
    <% end %>
  </div>

  <div class="col-start-2">
    <%= if @user.share_subscriptions do %>
      {dgettext("frontend", "I do currently share my subscriptions.")}
    <% else %>
      {dgettext("frontend", "I do not share my subscriptions.")}
    <% end %>
  </div>

  <div class="justify-self-end">{dgettext("frontend", "Languages I speak")}</div>
  <div>
    <span :if={@user.languages == []}>{dgettext("frontend", "No languages selected.")}</span>
    <span
      :for={language <- @user.languages |> Enum.uniq_by(&PanWeb.Language.group_key/1)}
      class="mr-3 whitespace-nowrap"
    >
      {language.emoji} {PanWeb.Translations.language_name(language)}
    </span>
  </div>
</div>

<%= if @user.invoices != [] do %>
  <h2 class="text-2xl my-4">
    {dgettext("frontend", "My invoices")}
  </h2>
  {dgettext("frontend", "All invoices, that appear here, have been paid already.")}
  <ul class="list-disc my-4 ml-4">
    <%= for invoice <- @user.invoices do %>
      <li>
        {icon("calendar")}
        {Calendar.strftime(invoice.inserted_at, "%x %H:%M")} &nbsp; &nbsp;
        <.link
          href={invoice_frontend_path(@conn, :download, invoice)}
          class="underline hover:text-primary"
        >
          {icon("file-download")} {invoice.filename}
        </.link>
      </li>
    <% end %>
  </ul>
<% end %>

{render("_personas.html", conn: @conn, user: @user)}
