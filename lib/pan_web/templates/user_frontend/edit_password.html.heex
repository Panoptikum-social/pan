<div class="m-4">
  <h1 class="text-3xl">
    {dgettext("frontend", "Change Password")}
  </h1>

  <.form
    :let={f}
    for={@changeset}
    action={user_frontend_path(@conn, :update_password)}
    class="p-4 mb-4 flex flex-col items-start space-y-4"
  >
    <.error :if={@changeset.action}>
      {dgettext("frontend", "Oops, something went wrong! Please check the errors below.")}
    </.error>
    <.input
      field={f[:password]}
      type="password"
      label={dgettext("frontend", "Password")}
      placeholder={dgettext("frontend", "Password")}
      class="input"
    />
    <.input
      field={f[:password_confirmation]}
      type="password"
      label={dgettext("frontend", "Password confirmation")}
      placeholder={dgettext("frontend", "Password Confirmation")}
      class="input"
    />
    <button type="submit" class="btn btn-primary">{dgettext("frontend", "Change Password")}</button>
  </.form>
</div>
