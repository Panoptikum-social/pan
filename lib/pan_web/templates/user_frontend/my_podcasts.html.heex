<div :if={@claimed_count > 0} class="alert alert-soft alert-success mb-4">
  {@claimed_count} podcast(s) listing your email address as owner have been assigned to you.
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
  <PanWeb.Component.Panel.render heading="Podcasts I manage" purpose="podcast" content_class="p-4">
    <p :if={@podcasts_i_own == []} class="text-sm">
      None yet. Podcasts whose feed lists your verified email address as owner are assigned to you here automatically.
    </p>
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <PanWeb.Component.PodcastButton.render
        :for={podcast <- @podcasts_i_own}
        for={podcast}
        truncate
      />
    </p>
  </PanWeb.Component.Panel.render>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-4">
  <PanWeb.Component.Panel.render
    heading="Subscriptions"
    purpose="subscription"
    content_class="p-4"
  >
    <p class="flex flex-wrap gap-x-4 gap-y-1 mb-4">
      <PanWeb.Component.PodcastButton.render
        :for={podcast <- @user.podcasts_i_subscribed}
        for={podcast}
        truncate
      />
    </p>
    <.link
      href={user_frontend_path(@conn, :like_all_subscribed)}
      method="post"
      class="btn btn-outline btn-primary btn-sm"
    >
      {icon("heart", class: "w-4 h-4")} Like all subscribed
    </.link>
    <.link
      href={user_frontend_path(@conn, :follow_all_subscribed)}
      method="post"
      class="btn btn-outline btn-info btn-sm"
    >
      {icon("heart", class: "w-4 h-4")} Follow all subscribed
    </.link>
  </PanWeb.Component.Panel.render>

  <PanWeb.Component.Panel.render heading="Podcasts I like" purpose="like" content_class="p-4">
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <PanWeb.Component.PodcastButton.render
        :for={podcast <- @podcasts_i_like}
        for={podcast}
        truncate
      />
    </p>
  </PanWeb.Component.Panel.render>

  <PanWeb.Component.Panel.render heading="Podcasts I follow" purpose="follow" content_class="p-4">
    <p class="flex flex-wrap gap-x-4 gap-y-1">
      <PanWeb.Component.PodcastButton.render
        :for={podcast <- @user.podcasts_i_follow}
        for={podcast}
        truncate
      />
    </p>
  </PanWeb.Component.Panel.render>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mt-4">
  <PanWeb.Component.Panel.render
    heading="Listeners of the podcasts you listen to, also listen to"
    purpose="recommendation"
    content_class="p-4 grid grid-cols-12 gap-x-4 gap-y-2"
  >
    <%= for {[count, id, title], rank} <- Enum.with_index(@recommendations) do %>
      <b class="justify-self-end">{rank + 1}.</b>
      <PanWeb.Component.PodcastButton.render
        id={id}
        title={truncate_string(title, 50)}
        class="justify-self-start col-span-9"
        truncate
      />
      <div class="col-span-2 justify-self-end">
        {count}
        {icon("user", class: "w-4 h-4 inline")}
      </div>
    <% end %>
  </PanWeb.Component.Panel.render>

  <PanWeb.Component.Panel.render
    heading="Users, who like the same podcasts as you, also like"
    purpose="popular"
    content_class="p-4 grid grid-cols-12 gap-x-4 gap-y-2"
  >
    <%= for {[count, id, title], rank} <- Enum.with_index(@also_liked) do %>
      <b class="justify-self-end">{rank + 1}.</b>
      <PanWeb.Component.PodcastButton.render
        id={id}
        title={truncate_string(title, 50)}
        class="justify-self-start col-span-9"
        truncate
      />
      <div class="col-span-2 justify-self-end">
        {count}
        {icon("user", class: "w-4 h-4 inline")}
      </div>
    <% end %>
  </PanWeb.Component.Panel.render>

  <PanWeb.Component.Panel.render
    heading="The categories my podcasts are assigned to"
    purpose="category"
    content_class="p-4 grid grid-cols-12 gap-x-4 gap-y-2"
  >
    <%= for {[count, id, title, icon, color], rank} <- Enum.with_index(@categories) do %>
      <b class="justify-self-end">{rank + 1}.</b>
      <PanWeb.Component.CategoryLink.render
        for={%{id: id, title: truncate_string(title, 50), icon: icon}}
        color={color}
        class="justify-self-start col-span-9"
        truncate
      />
      <div class="col-span-2 justify-self-end">
        {count}
        {icon("user", class: "w-4 h-4 inline")}
      </div>
    <% end %>
  </PanWeb.Component.Panel.render>
</div>
