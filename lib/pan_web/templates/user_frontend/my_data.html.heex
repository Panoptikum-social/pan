      >{PanWeb.Translations.category_title(category)}</.link>
    </li>
  <% end %>
</ul>

<h2 class="text-2xl mb-4 mt-8">{dgettext("frontend", "Recommendations")}</h2>

<p class="mb-2">
  {dgettext(
    "frontend",
    "You can delete a recommendation by clicking the Delete button next to it."
  )} <br />
  {dgettext(
    "frontend",
    "You can double check the context by clicking the podcast or episode link, that will open podcast or episode in a new tab, respectively."
  )}
</p>
{dgettext(
  "frontend",
  "You can even delete all the recommendations, you created so far, at once, by clicking"
)} &nbsp;
<.link
  href={recommendation_frontend_path(@conn, :delete_all)}
  method="delete"
  data-confirm={dgettext("frontend", "Are you sure? All recommendations will be deleted!")}
  class="btn btn-outline btn-error whitespace-nowrap leading-10"
>
  {icon("alert-triangle")} {dgettext("frontend", "Delete all recommendations")}
</.link>

<table class="table table-zebra table-xs my-4 w-auto">
  <thead>
    <tr>
      <th>{dgettext("frontend", "Object")}</th>
      <th>{dgettext("frontend", "Date")}</th>
    </tr>
    <tr>
      <th>{dgettext("frontend", "Comment")}</th>
      <th>{dgettext("frontend", "Actions")}</th>
    </tr>
  </thead>

  <tbody>
    <%= for recommendation <- @user.recommendations do %>
      <tr>
        <td>
          <%= cond do %>
            <% recommendation.podcast -> %>
              {dgettext("frontend", "Podcast:")}
              <.link
                href={podcast_frontend_path(@conn, :show, recommendation.podcast)}
                target="_blank"
                class="underline hover:text-primary"
              >{recommendation.podcast.title}</.link>
            <% recommendation.episode -> %>
              {dgettext("frontend", "Episode:")}
              <.link
                href={episode_frontend_path(@conn, :show, recommendation.episode)}
                target="_blank"
                class="underline hover:text-primary"
              >{recommendation.episode.title}</.link>
            <% recommendation.chapter -> %>
              <.link
                href={episode_frontend_path(@conn, :show, recommendation.chapter.episode_id)}
                target="_blank"
                class="underline hover:text-primary"
              >{recommendation.chapter.title}</.link>
          <% end %>
        </td>
        <td>
          <nobr>
            {Calendar.strftime(recommendation.inserted_at, "%c")}
          </nobr>
        </td>
      </tr>
      <tr>
        <td>{recommendation.comment}</td>
        <td class="text-center">
          <.link
            href={recommendation_frontend_path(@conn, :delete, recommendation)}
            method="delete"
            data-confirm={dgettext("frontend", "Are you sure?")}
            class="btn btn-outline btn-error btn-xs"
          >{dgettext("frontend", "Delete")}</.link>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="border-2 border-error p-4 max-w-xl rounded-xl my-4">
  <h2 class="text-lg text-error">
    {dgettext("frontend", "Danger Zone")}
  </h2>

  <p class="mb-4">
    {dgettext(
      "frontend",
      "You can of course delete your account. This will delete all your data as well."
    )}
    <br />{dgettext(
      "frontend",
      "We would be really sad to see you leave. But you can always sign up for a new account."
    )}
  </p>

  <.link
    href={user_frontend_path(@conn, :delete_my_account)}
    method="delete"
    data-confirm={dgettext("frontend", "Are you sure? Your account would be deleted!")}
    class="btn btn-outline btn-error"
  >
    {icon("alert-triangle")} {dgettext("frontend", "Delete my account")}
  </.link>
</div>
