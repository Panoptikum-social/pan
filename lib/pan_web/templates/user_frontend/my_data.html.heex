<h1 class="text-3xl">
  {dgettext("frontend", "My Data")}
</h1>

<p class="mt-8 mb-4">
  <div class="float-right">
    {dgettext("frontend", "Manage")} &nbsp;
    <.link
      href={user_frontend_path(@conn, :my_profile)}
      target="_blank"
      class="btn btn-sm"
    >
      {icon("user-circle")} {dgettext("frontend", "My Profile")}
    </.link>
  </div>
  <h2 class="text-2xl">{dgettext("frontend", "Account")}</h2>
</p>

<p class="my-4">
  <.link
    href={user_json_download_path(@conn, :download)}
    class="btn btn-primary"
  >
    {icon("file-download")} {dgettext("frontend", "Download")}
  </.link>
  {dgettext("frontend", "all my data as JSON-File")}
</p>

<dl class="grid grid-cols-2 gap-x-4 max-w-4xl">
  <dt class="text-right">{dgettext("frontend", "Name")}</dt>
  <dd>{@user.name}</dd>
  <dt class="text-right">{dgettext("frontend", "Username")}</dt>
  <dd>{@user.username}</dd>
  <dt class="text-right">{dgettext("frontend", "Email")}</dt>
  <dd>{@user.email}</dd>
  <dt class="text-right">{dgettext("frontend", "Email address verified?")}</dt>
  <dd>{@user.email_verified}</dd>
  <dt class="text-right">{dgettext("frontend", "Last login")}</dt>
  <dd>{@user.last_login_at}</dd>
  <dt class="text-right">{dgettext("frontend", "Is podcaster?")}</dt>
  <dd>{@user.podcaster}</dd>
  <dt class="text-right">{dgettext("frontend", "Shares subscriptions?")}</dt>
  <dd>{@user.share_subscriptions}</dd>
  <dt class="text-right">{dgettext("frontend", "Shares follows?")}</dt>
  <dd>{@user.share_follows}</dd>
  <dt class="text-right">{dgettext("frontend", "Interface language")}</dt>
  <dd>{@user.locale}</dd>
  <dt class="text-right">{dgettext("frontend", "Languages I speak")}</dt>
  <dd>{@user.languages |> Enum.map(& &1.shortcode) |> Enum.sort() |> Enum.join(", ")}</dd>
</dl>

<div class="mt-8 mb-4">
  <div class="float-right">
    {dgettext("frontend", "Manage")} &nbsp;
    <.link
      href={opml_frontend_path(@conn, :index)}
      target="_blank"
      class="btn btn-sm"
    >
      {icon("file-download")} {dgettext("frontend", "My OPMLs")}
    </.link>
  </div>
  <h2 class="text-2xl">{dgettext("frontend", "OPML Files")}</h2>
</div>

<ul class="list-disc ml-4">
  <%= for opml <- @user.opmls do %>
    <li>{opml.filename}</li>
  <% end %>
</ul>

<h2 class="text-2xl mb-4 mt-8">{dgettext("frontend", "Personas")}</h2>
{dgettext(
  "frontend",
  "You can even delete all manifestations as personas, you created so far, at once, by clicking"
)} &nbsp;
<.link
  href={manifestation_frontend_path(@conn, :delete_all)}
  method="delete"
  data-confirm={dgettext("frontend", "Are you sure? All manifestations will be deleted!")}
  class="btn btn-outline btn-error whitespace-nowrap leading-10"
>
  {icon("alert-triangle")} {dgettext("frontend", "Delete all manifestations")}
</.link>

<%= for persona <- @user.personas do %>
  <h3 class="text-xl my-4">
    Persona {persona.name}
    <.link
      href={manifestation_frontend_path(@conn, :delete, persona.id)}
      method="delete"
      data-confirm={dgettext("frontend", "Are you sure?")}
      class="btn btn-outline btn-error btn-xs whitespace-nowrap"
    >{dgettext("frontend", "Delete Manifestation")}</.link>
  </h3>

  <dl class="grid grid-cols-2 gap-x-6 max-w-2xl">
    <dt class="text-right">{dgettext("frontend", "PanoptikumID")}</dt>
    <dd>{persona.pid}</dd>
    <dt class="text-right">{dgettext("frontend", "Name")}</dt>
    <dd>{persona.name}</dd>
    <dt class="text-right">{dgettext("frontend", "Uri")}</dt>
    <dd>{persona.uri}</dd>
    <dt class="text-right">{dgettext("frontend", "Email")}</dt>
    <dd>{persona.email}</dd>
    <dt class="text-right">{dgettext("frontend", "Description")}</dt>
    <dd>{persona.description}</dd>
    <dt class="text-right">{dgettext("frontend", "Url")}</dt>
    <dd>{persona.image_url}</dd>
    <dt class="text-right">{dgettext("frontend", "Title")}</dt>
    <dd>{persona.image_title}</dd>
  </dl>
<% end %>

<%= for persona <- @user.user_personas do %>
  <h3 class="text-xl my-4">
    Persona {persona.name}
    <.link
      href={persona_frontend_path(@conn, :disconnect, persona.id)}
      method="post"
      data-confirm={dgettext("frontend", "Are you sure?")}
      class="btn btn-outline btn-error btn-xs whitespace-nowrap"
    >{dgettext("frontend", "Disconnect Persona")}</.link>
  </h3>

  <dl class="grid grid-cols-2 gap-x-6 max-w-2xl">
    <dt class="text-right">{dgettext("frontend", "PanoptikumID")}</dt>
    <dd>{persona.pid}</dd>
    <dt class="text-right">{dgettext("frontend", "Name")}</dt>
    <dd>{persona.name}</dd>
    <dt class="text-right">{dgettext("frontend", "Uri")}</dt>
    <dd>{persona.uri}</dd>
    <dt class="text-right">{dgettext("frontend", "Email")}</dt>
    <dd>{persona.email}</dd>
    <dt class="text-right">{dgettext("frontend", "Description")}</dt>
    <dd>{persona.description}</dd>
    <dt class="text-right">{dgettext("frontend", "Url")}</dt>
    <dd>{persona.image_url}</dd>
    <dt class="text-right">{dgettext("frontend", "Title")}</dt>
    <dd>{persona.image_title}</dd>
  </dl>
<% end %>

<h2 class="text-2xl mb-4 mt-8">{dgettext("frontend", "Invoices")}</h2>
{dgettext(
  "frontend",
  "Invoices cannot be deleted, we have to store them due to fiscal regulations."
)}
<%= for invoice <- @user.invoices do %>
  <dl class="grid grid-cols-2 gap-x-6 max-w-2xl">
    <dt class="text-right">{dgettext("frontend", "Date")}</dt>
    <dd>{Calendar.strftime(invoice.inserted_at, "%x %H:%M")}</dd>
    <dt class="text-right">{dgettext("frontend", "File")}</dt>
    <dd>
      <.link href={invoice_frontend_path(@conn, :download, invoice)}>{invoice.filename}</.link>
    </dd>
  </dl>
  <br />
<% end %>

<h2 class="text-2xl mb-4 mt-8">{dgettext("frontend", "Subscribed Podcasts")}</h2>

<p class="mb-2">
  {dgettext(
    "frontend",
    "Click on the podcast link to open the podcast show page in a new tab to un/like, un/subscribe, un/follow."
  )}
</p>
{dgettext(
  "frontend",
  "You can even delete all the subscriptions, you created so far, at once, by clicking"
)} &nbsp;
<.link
  href={subscription_frontend_path(@conn, :delete_all)}
  method="delete"
  data-confirm={dgettext("frontend", "Are you sure? All subscriptions will be deleted!")}
  class="btn btn-outline btn-error whitespace-nowrap leading-10"
>
  {icon("alert-triangle")} {dgettext("frontend", "Delete all subscriptions")}
</.link>

<ul class="list-disc m-4">
  <%= for podcast <- @user.podcasts_i_subscribed do %>
    <li>
      <.link
        href={podcast_frontend_path(@conn, :show, podcast)}
        target="_blank"
        class="underline hover:text-primary"
      >{podcast.title}</.link>
    </li>
  <% end %>
</ul>

<h2 class="text-2xl my-4">{dgettext("frontend", "Followed Podcasts")}</h2>

<p class="mb-2">
  {dgettext(
    "frontend",
