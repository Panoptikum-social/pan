<div class="m-auto max-w-6xl">
  <h1 class="text-3xl">
    Update Profile
  </h1>

  <.form
    :let={f}
    for={@changeset}
    action={user_frontend_path(@conn, :update)}
    class="p-4 flex flex-col items-start space-y-4"
  >
    <.error :if={@changeset.action}>
      Oops, something went wrong! Please check the errors below.
    </.error>
    <.input field={f[:name]} type="text" label="Name" placeholder="Name" class="input" />
    <.input
      field={f[:username]}
      type="text"
      label="Username"
      placeholder="Username"
      class="input"
    />
    <.input field={f[:email]} type="email" label="Email" placeholder="Email" class="input" />
    <.input field={f[:podcaster]} type="checkbox" label="I am a podcaster" />
    <.input field={f[:share_follows]} type="checkbox" label="I want to share my followings" />
    <.input
      field={f[:share_subscriptions]}
      type="checkbox"
      label="I want to share my subscriptions"
    />

    <fieldset class="w-full">
      <legend class="mb-1">
        Languages I speak
        <span class="block text-xs font-normal text-gray-dark">
          Used to optionally restrict search results to podcasts/episodes in these languages.
        </span>
      </legend>
      <input type="hidden" name="user[language_group_ids][]" value="" />
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 gap-y-1 max-h-128 overflow-y-auto border border-gray p-2 rounded-md">
        <label
          :for={group <- @language_groups}
          class="flex items-center gap-1 text-sm min-w-0"
        >
          <input
            type="checkbox"
            name="user[language_group_ids][]"
            value={group.representative_id}
            checked={Enum.any?(group.ids, &(&1 in @selected_language_ids))}
            class="checkbox checkbox-xs shrink-0"
          />
          <span class="truncate">{group.emoji} {group.name}</span>
        </label>
      </div>
    </fieldset>

    <button type="submit" class="btn btn-primary">Update Profile</button>
  </.form>
</div>
