<h1 class="text-3xl">
  Users
</h1>

<% grouped_users = Enum.group_by(@users, fn p -> p.name |> String.first() |> String.upcase() end) %>
<% letters = Map.keys(grouped_users) |> Enum.sort() %>

<div x-data={"{ selectedTab: #{Enum.find_index(letters, &(&1 == "A"))} }"} class="pt-4">
  <ul class="flex flex-wrap border-b border-base-300">
    <%= for {letter, index} <- letters |> Enum.with_index() do %>
      <li class="-mb-px ml-1.5">
        <a
          class="inline-block rounded-t px-2 py-1.5 hover:text-primary border-base-300"
          x-bind:class={"{ 'disabled font-semibold bg-base-100 border-l border-t border-r text-base-content' :
                       selectedTab === #{index},
                     'bg-base-300 text-base-content/70' :
                     selectedTab !== #{index} }"}
          @click.prevent={"selectedTab = #{index}"}
          to="#"
        >
          {letter}
        </a>
      </li>
    <% end %>
  </ul>

  <div class="pt-4">
    <%= for {letter, index} <- letters |> Enum.with_index() do %>
      <div class="flex flex-wrap items-start" x-show={"selectedTab === #{index}"}>
        <%= for user <- grouped_users[letter] do %>
          <PanWeb.Component.UserButton.render for={user} class="mr-4 mb-1" />
        <% end %>
      </div>
    <% end %>
  </div>
</div>
