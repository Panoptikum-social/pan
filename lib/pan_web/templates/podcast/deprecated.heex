<div class="m-4">
  <h1 class="text-3xl">
    10 longest deprecated Podcasts
  </h1>

  <p class="my-2 text-sm">
    Nothing here is automatic — probing only computes a recommendation.
    Click Delete or Unretire yourself to actually act on a podcast.
  </p>

  <table class="table table-zebra table-xs my-4 w-auto">
    <thead>
      <tr>
        <th>ID</th>
        <th>Title</th>
        <th>Last build date</th>
        <th># Episodes</th>
        <th>Last Episode</th>
        <th>Last Episode Url</th>
        <th>Feed Status</th>
        <th>Episode Status</th>
        <th>Recommendation</th>
        <th>Other Actions</th>
      </tr>
    </thead>
    <tbody>
      <%= for deprecated_podcast <- @deprecated_podcasts do %>
        <tr>
          <td>{deprecated_podcast.id}</td>
          <td>{deprecated_podcast.title}</td>
          <td>{deprecated_podcast.last_build_date}</td>
          <td>{deprecated_podcast.episodes_count}</td>
          <td>
            <%= if Enum.at(deprecated_podcast.episodes, 0) do %>
              <.link
                href={
                  episode_frontend_path(@conn, :show, Enum.at(deprecated_podcast.episodes, 0).id)
                }
                class="btn btn-info btn-sm max-w-60 justify-start"
              >
                <span class="truncate min-w-0">
                  {Enum.at(deprecated_podcast.episodes, 0).title}
                </span>
              </.link>
            <% end %>
          </td>
          <td>
            <%= if Enum.at(deprecated_podcast.episodes, 0) do %>
              {Enum.at(deprecated_podcast.episodes, 0).url}
            <% end %>
          </td>
          <td>{deprecated_podcast.feed_status_code}</td>
          <td>{deprecated_podcast.episode_status_code}</td>
          <td>
            <%= case deprecated_podcast.recommended_action do %>
              <% :delete -> %>
                <.link
                  href={podcast_path(@conn, :delete, deprecated_podcast)}
                  method="delete"
                  target="_blank"
                  class="btn btn-error btn-xs"
                >Delete</.link>
              <% :unretire -> %>
                <.link
                  href={podcast_path(@conn, :unretire, deprecated_podcast)}
                  target="_blank"
                  class="btn btn-info btn-xs"
                >Unretire</.link>
              <% :inconclusive -> %>
                inconclusive
            <% end %>
          </td>
          <td>
            <%= if deprecated_podcast.recommended_action != :delete do %>
              <.link
                href={podcast_path(@conn, :delete, deprecated_podcast)}
                method="delete"
                target="_blank"
                class="btn btn-error btn-xs"
              >Delete</.link>
            <% end %>
            <%= if deprecated_podcast.recommended_action != :unretire do %>
              <.link
                href={podcast_path(@conn, :unretire, deprecated_podcast)}
                target="_blank"
                class="btn btn-info btn-xs"
              >Unretire</.link>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
