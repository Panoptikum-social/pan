<!DOCTYPE html>
<html lang="en" class="h-full">
  {render(PanWeb.LayoutView, "_head.html", conn: @conn)}
  <% current_user = %PanWeb.User{
    id: 0,
    admin: false,
    name: "Dummy",
    username: "Dummy",
    email: "noreply@panoptikum.social"
  } %>

  <body
    class="flex flex-col lg:flex-row lg:h-full text-base-content bg-base-300 scrollbar-gray"
    data-js-view-name="StaticTemplateView"
  >
    <nav
      x-data="navbar"
      class="h-full flex flex-col p-4 justify-start lg:overflow-y-auto"
      x-bind:class="{'lg:p-1': !navbarOpen}"
    >
      {render(PanWeb.LayoutView, "_navbar.html", conn: @conn, current_user: current_user)}
    </nav>

    <div class="flex-1 min-h-full flex flex-col overflow-x-auto">
      <div class="bg-base-200 flex-1 text-base-content justify-self-center">
        <div class="mx-auto max-w-lg mt-12 px-4 space-y-4">
          <h1 class="text-3xl font-semibold">
            {@conn.status} {Plug.Conn.Status.reason_phrase(@conn.status)}
          </h1>
          <p :if={@conn.status == 404}>
            The page you requested doesn't exist (anymore). Please check the address,
            or use the search in the navigation.
          </p>
          <p :if={@conn.status != 404}>
            We couldn't make sense of this request. Please check the address,
            or use the search in the navigation.
          </p>
          <p>
            <a class="link link-primary" href="/">Go to the start page</a>
          </p>
        </div>
      </div>

      <footer class="p-4 flex flex-col lg:flex-row space-y-4 lg:space-y-0 lg:space-x-12
                  justify-evenly place-self-center">
        {render(PanWeb.LayoutView, "_footer.html", conn: @conn, current_user: current_user)}
      </footer>
      <div class="flex justify-center w-full font-medium pb-4">
        <p>
          Hosted by
          <a class="underline hover:text-primary" href="https://www.informatom.com">
            Informatom EDV-Dienstleistungen e.U.
          </a>
        </p>
      </div>
    </div>
  </body>
</html>
